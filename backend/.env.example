DB_URL=jdbc:postgresql://localhost:5432/base_conocimiento
DB_USERNAME=base_conocimiento
DB_PASSWORD=cambiar_en_cada_entorno
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
ADMIN_INITIAL_EMAIL=admin@municipio.local
ADMIN_INITIAL_PASSWORD=cambiar-inmediatamente

# IA opcional, local y sin descargas automáticas
IA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=granite4.2:3b
OLLAMA_AGENT_MODEL=granite4.2:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_TIMEOUT=120s
OLLAMA_CONNECT_TIMEOUT=2s
OLLAMA_CONTEXT_TOKENS=2048
IA_MAX_PROMPT_CHARS=4000
IA_MAX_OUTPUT_TOKENS=128
IA_MAX_EMBEDDING_BATCH=8
IA_MAX_RESPONSE_BYTES=1048576

# Extracción documental opcional: no guarda archivos en el conocimiento
DOCUMENTS_ENABLED=false
DOCUMENT_TEMP_PATH=../.local/documentos-temporales
DOCUMENT_TIMEOUT=60s
DOCUMENT_MAX_FILE_SIZE=10485760
DOCUMENT_MAX_PAGES=10
DOCUMENT_MAX_OCR_PAGES=3
DOCUMENT_MAX_CHARS=40000
DOCUMENT_MAX_PIXELS=6000000
DOCUMENT_MAX_TEMP_BYTES=33554432
DOCUMENT_RENDER_DPI=120
TESSERACT_COMMAND=tesseract
TESSERACT_DATA_PATH=
TESSERACT_LANGUAGES=spa+eng

# Índice derivado, independiente del guardado normal
RAG_INDEX_ENABLED=false
RAG_EMBEDDINGS_ENABLED=false
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_MAX_CHUNKS=128
RAG_MAX_SOURCES=100
RAG_MAX_ATTACHMENTS=3
RAG_INDEX_TIMEOUT=120s
RAG_INDEX_INTERVAL=15000
RAG_INDEX_INITIAL_DELAY=30000

# Consulta híbrida y respuesta extractiva con fuentes
RAG_ENABLED=false
RAG_SEMANTIC_ENABLED=true
RAG_MAX_QUESTION_CHARS=1000
RAG_MAX_CANDIDATES=2000
RAG_MAX_RESULTS=3
RAG_MAX_CONTEXT_CHARS=1600
RAG_MIN_SIMILARITY=0.65
RAG_QUERY_TIMEOUT=240s
